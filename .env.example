# StreamRoots environment — copy to .env and adjust.
# PostgreSQL connection (Prisma owns the schema: `npm run db:push`).
DATABASE_URL=postgresql://streamroots:password@localhost:5432/streamroots
# Session-token signing secret (HMAC-SHA256). MUST be set in production.
AUTH_SECRET=change-me-to-a-long-random-string
# Optional: point the frontend server actions at the .NET API
# (backend/StreamRoots.Api). Empty = direct Prisma path.
# STREAMROOTS_API_URL=http://127.0.0.1:5080
